      "id": "offline-ftab-markdown-sort-and-take",
      "profiles": ["offline"],
      "sources": [
        "CosmosDBShell.Tests/CommandTests/FtabCommandTests.cs::ExecuteAsync_SortsObjectRows_Descending",
        "CosmosDBShell.Tests/CommandTests/FtabCommandTests.cs::ExecuteAsync_AppliesFieldsAndTake_ToDocumentsWrapper"
