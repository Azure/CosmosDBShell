    {
      "id": "offline-doctor-disconnected-without-update-check",
      "profiles": ["offline"],
      "sources": [
        "CosmosDBShell.Tests/Integration/ShellProcessTests.cs::Doctor_ReportsJsonAndRequiredCheckExitCode",
        "CosmosDBShell.Tests/CommandTests/DoctorCommandTests.cs::WhoAliases_ReturnStructuredContextWithoutTextHeading"
      ],
      "format": "json",
      "script": "doctor who --no-update-check > 'report.json'",
      "exitCode": 0,
      "files": {
        "report.json": {
          "mode": "json",
          "schema": {
            "type": "object",
            "required": ["schemaVersion", "status", "summary", "checks"],
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {"const": 1},
              "status": {"const": "PASS"},
              "summary": {
                "type": "object",
                "required": ["fail", "durationMs", "requestCharge"],
                "properties": {"fail": {"const": 0}, "durationMs": {"type": "integer", "minimum": 0}, "requestCharge": {"type": "null"}}
              },
              "checks": {
                "type": "array",
                "allOf": [
                  {"contains": {"required": ["id", "status"], "properties": {"id": {"const": "shell"}, "status": {"const": "PASS"}}}, "maxContains": 1},
                  {"contains": {"required": ["id", "status", "code"], "properties": {"id": {"const": "connection"}, "status": {"const": "SKIP"}, "code": {"const": "not-connected"}}}, "maxContains": 1},
                  {"contains": {"required": ["id", "status", "code"], "properties": {"id": {"const": "updates"}, "status": {"const": "SKIP"}, "code": {"const": "update-check-disabled"}}}, "maxContains": 1}
                ],
                "items": {"type": "object"}
              }
            }
          }
        },
        "stdout.txt": {"mode": "empty"},
        "stderr.txt": {"mode": "empty"}
      }
    },
    {
