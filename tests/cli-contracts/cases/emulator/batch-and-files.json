    {
      "id":"emulator.files.import-export-json",
      "profiles":["emulator-linux","emulator-windows"],
      "sources":["CosmosDBShell.Tests/CommandTests/ImportCommandTests.cs::EnumerateJsonDocumentAsync_ObjectSequence_YieldsItems","CosmosDBShell.Tests/CommandTests/ExportCommandTests.cs::WriteArrayAsync_WritesValidStreamingArray"],
