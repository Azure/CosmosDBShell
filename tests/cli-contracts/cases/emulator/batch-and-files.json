      "id":"emulator.batch.create-patch-atomic",
      "profiles":["emulator-linux","emulator-windows"],
      "sources":["CosmosDBShell.Tests/Integration/BatchOperationTests.cs::BatchRun_CreateThenPatch_AppliesBoth","CosmosDBShell.Tests/Integration/BatchOperationTests.cs::BatchRun_MultipleCreates_CommitsAtomically"],
      "script":"connect 'AccountEndpoint=${ENDPOINT};AccountKey=${EMULATOR_KEY};' --mode gateway; cd '${DB}/items'; batch run '[{\"op\":\"create\",\"item\":{\"id\":\"a\",\"pk\":\"tenant\",\"status\":\"new\"}},{\"op\":\"patch\",\"id\":\"a\",\"operations\":[{\"op\":\"set\",\"path\":\"/status\",\"value\":\"done\"}]}]' --partition-key tenant > 'result.json'; query \"SELECT c.id,c.pk,c.status FROM c\" > 'items.json'",
      "exitCode":0,
      "emulator":{"containers":[{"id":"items","partitionKey":["/pk"],"items":[]}],"verify":{"containers":[{"id":"items","partitionKey":["/pk"],"items":[{"id":"a","pk":"tenant","status":"done"}]}]}},
      "files":{
        "result.json":{"mode":"json","schema":{"type":"object","required":["success","statusCode","requestCharge","operationCount","operations"],"additionalProperties":false,"properties":{"success":{"const":true},"statusCode":{"const":200},"requestCharge":{"type":"number","exclusiveMinimum":0,"maximum":100},"operationCount":{"const":2},"operations":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"type":"object","required":["index","op","statusCode"],"properties":{"index":{"const":0},"op":{"const":"create"},"statusCode":{"const":201}}},{"type":"object","required":["index","op","id","statusCode"],"properties":{"index":{"const":1},"op":{"const":"patch"},"id":{"const":"a"},"statusCode":{"const":200}}}]}}}},
        "items.json":{"mode":"json","expected":{"type":"item","values":[{"id":"a","pk":"tenant","status":"done"}]}},
        "stderr.txt":{"mode":"empty"}
      }
    },
